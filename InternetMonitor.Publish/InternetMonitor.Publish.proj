<Project>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <PublishRoot>$(MSBuildThisFileDirectory)..\Publish\$(RuntimeIdentifier)\</PublishRoot>

    <CliProject>$(MSBuildThisFileDirectory)..\InternetMonitor.CLI\InternetMonitor.CLI.csproj</CliProject>
    <ServiceProject>$(MSBuildThisFileDirectory)..\InternetMonitor.Service\InternetMonitor.Service.csproj</ServiceProject>
    <UiProject>$(MSBuildThisFileDirectory)..\InternetMonitor.UI\InternetMonitor.UI.csproj</UiProject>

    <CliPublishDir>$(PublishRoot)CLI\</CliPublishDir>
    <ServicePublishDir>$(PublishRoot)Service\</ServicePublishDir>
    <UiPublishDir>$(PublishRoot)UI\</UiPublishDir>
    <PackageDir>$(PublishRoot)Package\</PackageDir>
  </PropertyGroup>


  <!-- ============================================================
       Restore all publish projects for the selected runtime
       ============================================================ -->

  <Target Name="RestoreProjects">

    <Message Importance="high"
             Text="Restoring projects for $(RuntimeIdentifier)..." />

    <MSBuild
      Projects="$(CliProject);$(ServiceProject);$(UiProject)"
      Targets="Restore"
      Properties="
        Configuration=$(Configuration);
        RuntimeIdentifier=$(RuntimeIdentifier)" />

  </Target>


  <!-- ============================================================
       Publish CLI
       ============================================================ -->

  <Target Name="PublishCli"
          DependsOnTargets="RestoreProjects">

    <Message Importance="high"
             Text="Publishing InternetMonitor.CLI..." />

    <MSBuild
      Projects="$(CliProject)"
      Targets="Publish"
      Properties="
        Configuration=$(Configuration);
        RuntimeIdentifier=$(RuntimeIdentifier);
        Restore=true;
        PublishDir=$(CliPublishDir)" />

  </Target>


  <!-- ============================================================
       Publish Service
       ============================================================ -->

  <Target Name="PublishService">

    <Message Importance="high"
             Text="Publishing InternetMonitor.Service..." />

    <MSBuild
      Projects="$(ServiceProject)"
      Targets="Publish"
      Properties="
        Configuration=$(Configuration);
        RuntimeIdentifier=$(RuntimeIdentifier);
        Restore=true;
        PublishDir=$(ServicePublishDir)" />

  </Target>


  <!-- ============================================================
       Publish UI
       ============================================================ -->

  <Target Name="PublishUi">

    <Message Importance="high"
             Text="Publishing InternetMonitor.UI..." />

    <MSBuild
      Projects="$(UiProject)"
      Targets="Publish"
      Properties="
        Configuration=$(Configuration);
        RuntimeIdentifier=$(RuntimeIdentifier);
        Restore=true;
        SelfContained=true;
        PublishSingleFile=false;
        PublishDir=$(UiPublishDir)" />

  </Target>


  <Target Name="PreparePackage"
          DependsOnTargets="PublishCli;PublishService;PublishUi">

    <Message Importance="high"
             Text="Preparing package directory..." />

    <RemoveDir
      Directories="$(PackageDir)"
      Condition="Exists('$(PackageDir)')" />

    <MakeDir
      Directories="$(PackageDir)" />

  </Target>


  <!-- ============================================================
       Package CLI
       ============================================================ -->

  <Target Name="PackageCli"
          DependsOnTargets="PreparePackage">

    <ItemGroup>
      <CliFiles Include="$(CliPublishDir)**\*" />
    </ItemGroup>

    <Message Importance="high"
             Text="Copying CLI files..." />

    <Copy
      SourceFiles="@(CliFiles)"
      DestinationFiles="@(CliFiles->'$(PackageDir)CLI\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

  </Target>


  <!-- ============================================================
       Package Service
       ============================================================ -->

  <Target Name="PackageService"
          DependsOnTargets="PreparePackage">

    <ItemGroup>
      <ServiceFiles Include="$(ServicePublishDir)**\*" />
    </ItemGroup>

    <Message Importance="high"
             Text="Copying Service files..." />

    <Copy
      SourceFiles="@(ServiceFiles)"
      DestinationFiles="@(ServiceFiles->'$(PackageDir)Service\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

  </Target>


  <!-- ============================================================
       Package UI
       ============================================================ -->

  <Target Name="PackageUi"
          DependsOnTargets="PreparePackage">

    <ItemGroup>
      <UiFiles Include="$(UiPublishDir)**\*" />
    </ItemGroup>

    <Message Importance="high"
             Text="Copying UI files..." />

    <Copy
      SourceFiles="@(UiFiles)"
      DestinationFiles="@(UiFiles->'$(PackageDir)UI\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

  </Target>


  <Target Name="PackageTools"
          DependsOnTargets="PreparePackage">

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
      <ToolFiles
        Include="$(MSBuildThisFileDirectory)..\Tools\speedtest\windows\**\*" />
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
      <ToolFiles
        Include="$(MSBuildThisFileDirectory)..\Tools\speedtest\linux\**\*" />
    </ItemGroup>

    <Message Importance="high"
             Text="Copying platform tools..." />

    <Copy
      SourceFiles="@(ToolFiles)"
      DestinationFiles="@(ToolFiles->'$(PackageDir)Tools\speedtest\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

  </Target>


  <!-- ============================================================
       Complete Package
       ============================================================ -->

  <Target Name="Publish"
          DependsOnTargets="PackageCli;PackageService;PackageUi;PackageTools">

    <Message Importance="high"
             Text="==============================================" />

    <Message Importance="high"
             Text="Internet Monitor package created:" />

    <Message Importance="high"
             Text="$(PackageDir)" />

    <Message Importance="high"
             Text="==============================================" />

  </Target>

</Project>